# user (name / email) はマシンローカルの ~/.gitconfig.local に書く
# 例:
#   [user]
#       name = Ryo Koresawa
#       email = <company-email>
[include]
	path = ~/.gitconfig.local

[ghq]
	root = ~/src

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main

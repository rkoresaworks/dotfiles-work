{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "display-resolution",
  "title": "Display Resolution",
  "description": "displayplacer でメインの解像度を切り替え、同時にサブをメイン直下・水平中央に配置する",
  "icon": "extension-icon.png",
  "author": "koresawa",
  "license": "MIT",
  "categories": [
    "System"
  ],
  "commands": [
    {
      "name": "set-resolution",
      "title": "Set Display Resolution",
      "subtitle": "Display",
      "description": "解像度一覧から選択して適用（サブは自動で中心揃え）",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.82.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "postinstall": "rm -rf node_modules/react"
  }
}